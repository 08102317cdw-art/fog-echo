; Engine configuration file.
config_version=5

[application]

config/name="寂静岭同人 · 雾中回响"
config/description="Silent Hill fan-made demo (non-official)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="SH_FogEcho"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
textures/default_filters/anisotropic_filtering_level=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=80
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/use_debanding=true
